# Public application configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only database credentials
SUPABASE_SECRET_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@your-database-host:5432/postgres

# Administration and deployment
ADMIN_EMAIL=admin@example.com
DEPLOYMENT_ENV=development
ADMIN_ACCESS_MODE=database
ADMIN_STATIC_PASSWORD=replace-with-a-strong-password
ADMIN_COOKIE_SECRET=replace-with-a-long-random-secret
ADMIN_REQUIRE_MFA=false
SEED_DEFAULT_PASSWORD=replace-with-a-temporary-seed-password
SEED_RESET_PASSWORDS=false
ALLOW_PRODUCTION_SEED=false
ALLOW_DATA_REPAIR=false

# Payments
PAYMENT_MODE=simulated
PAYMENT_PROVIDER=zarinpal
PAYMENT_WEBHOOK_SECRET=replace-with-provider-webhook-secret
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
ZARINPAL_CALLBACK_URL=https://your-domain.example/api/payments/zarinpal/callback

# Integrations
WOOCOMMERCE_ENCRYPTION_KEY=replace-with-a-32-byte-random-key
OPENAI_API_KEY=your-openai-api-key
ANALYTICS_VISITOR_SALT=replace-with-a-long-random-secret

# Release and hosting
RELEASE_VERSION=development
COMMIT_SHA=local
STORE_SUBDOMAIN_ROOT=your-domain.example
CPANEL_API_TOKEN=your-cpanel-api-token
CPANEL_USERNAME=your-cpanel-username
CPANEL_PASS=your-cpanel-password
CPANNEL_URL=https://your-cpanel-host.example:2083
